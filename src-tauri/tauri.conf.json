{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Database Playground Desktop",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "icon": ["icons/256x256.png", "icons/128x128.png", "icons/32x32.png"],
      "active": true,
      "targets": "all",
      "identifier": "com.sdchat.db-playground",
      "publisher": "CHen Jianjun",
      "copyright": "Copyright © 2025 C2J. All rights reserved.",
      "category": "DeveloperTool",
      "shortDescription": "Database Playground Desktop application",
      "longDescription": "This is a Database Playground Desktop application building by Tauri with React and TypeScript."
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "windows": [
      {
        "title": "Database Playground Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "url": "index.html",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist"
  }
}
